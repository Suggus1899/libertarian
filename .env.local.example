# Public site URL (no trailing slash). Used for metadataBase, sitemap.xml,
# robots.txt and absolute Open Graph URLs.
NEXT_PUBLIC_SITE_URL=https://libertarian-nine.vercel.app

# Email configuration for the contact form (Resend).
# Get your API key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxx

# Sender address must be a verified domain in Resend.
CONTACT_FROM_EMAIL=onboarding@resend.dev

# Recipient address for contact form submissions.
CONTACT_TO_EMAIL=info@libertarianforum.org

# Postgres connection string (Neon, Vercel Postgres, Supabase, etc.)
# used by the admin panel to store essays and opinion articles.
DATABASE_URL=postgres://user:password@host:5432/dbname

# Secret used to sign the admin session JWT. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-random-64-char-hex-string

# Admin panel credentials (only one admin user).
ADMIN_EMAIL=admin@libertarianforum.org
# Generate the hash with: pnpm hash-password "your-password"
# IMPORTANT: escape every `$` as `\$` — Next.js expands unescaped `$VAR`
# patterns in .env files, which silently corrupts bcrypt hashes.
ADMIN_PASSWORD_HASH=\$2a\$12\$replace-with-generated-bcrypt-hash

# Optional: enables image upload (drag & drop / file picker) in the admin
# rich text editor. Create a Blob store in Vercel → Storage → Blob.
# Without it, admins can still add images by pasting a URL.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx
